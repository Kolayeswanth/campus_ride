# Supabase Configuration
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Ola Maps API Configuration
OLA_MAPS_API_KEY=your_ola_maps_api_key_here

# LocationIQ API Key (for reverse geocoding)
LOCATIONIQ_API_KEY=your_locationiq_api_key_here

# OpenRouteService API Key (fallback routing service)
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here

# MapTiler Configuration
MAPTILER_API_KEY=your_maptiler_api_key_here
MAPLIBRE_STYLE_URL=https://api.maptiler.com/maps/streets/style.json?key=your_maptiler_api_key_here